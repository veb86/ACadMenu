        <Revision MajorVersion="23" MinorVersion="1" UserVersion="1" />
        <ModifiedRev MajorVersion="23" MinorVersion="1" UserVersion="1" />
        <Name xlate="true" UID="XLS_BOBROV_SL_CREATE_NAME">Создать</Name>
        <Command>$M=$(if,$(getvar,cmdactive),^C^C)_SL_CREATE;</Command>
        <HelpString xlate="true" UID="XLS_BOBROV_SL_CREATE_HELP">Создать умную выноску (SL_CREATE)</HelpString>
        <SmallImage Name="BOBROV_SL_CREATE_16.png" />
        <LargeImage Name="BOBROV_SL_CREATE_32.png" />
        <CLICommand>SL_CREATE</CLICommand>
      </Macro>
    </MenuMacro>
