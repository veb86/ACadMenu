    </MenuMacro>
    <MenuMacro UID="ID_BOBROV_SL_UPDATE">
      <Macro type="Any">
        <Revision MajorVersion="23" MinorVersion="1" UserVersion="1" />
        <ModifiedRev MajorVersion="23" MinorVersion="1" UserVersion="1" />
        <Name xlate="true" UID="XLS_BOBROV_SL_UPDATE_NAME">Обновить</Name>
        <Command>$M=$(if,$(getvar,cmdactive),^C^C)_SL_UPDATE;</Command>
